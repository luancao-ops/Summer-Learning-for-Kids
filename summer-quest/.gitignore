# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/.next-build2/
/.next-build3/
/.next-build4/
/.next-build5/
/.next-build6/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database files
*.db
*.db-journal
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
